# All of these are server-only. Set them in Vercel: Project settings > Environment Variables.

# Supabase: Project settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site, used in email links. No trailing slash.
SITE_URL=https://tierbridge.in

# Admin panel at /admin. Password at least 12 characters; secret at least 32 random characters
# (for example: openssl rand -hex 32).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Claude writes the briefs and sorts jobs. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
CLAUDE_MODEL=

# Resend sends the emails. EMAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=TierBridge <brief@tierbridge.in>

# Vercel Cron sends this as a Bearer token. At least 16 random characters.
CRON_SECRET=

# Passive mode. true = send drafts at 7 AM without approval; new jobs go live without review.
AUTO_SEND_DRAFTS=false
AUTO_APPROVE_JOBS=false
